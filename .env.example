# GitHub App credentials
# Get App ID from: GitHub → Settings → Developer settings → GitHub Apps → Your App
GITHUB_APP_ID=your_app_id_here

# Generate private key from your GitHub App settings → Private keys → Generate a private key
# Convert to single line: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' ~/Downloads/*.pem | pbcopy
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Generate with: openssl rand -hex 32
# Must match the secret you set in GitHub App → Webhook Secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# LLM — Google Gemini (free tier: 1,500 req/day)
# Get free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=3010
NODE_ENV=development
